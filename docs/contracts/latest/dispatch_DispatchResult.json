    "PricesSummary": {
      "description": "Summary of prices used in simulation.\n\nFor transparency - user can verify what assumptions were used.",
      "properties": {
        "demand_charge_pln_kw_month": {
          "description": "Monthly demand charge [PLN/kW/month]",
          "title": "Demand Charge Pln Kw Month",
          "type": "number"
        },
        "demand_charge_pln_kw_year": {
          "default": 0.0,
          "description": "Annual demand charge [PLN/kW/year]",
