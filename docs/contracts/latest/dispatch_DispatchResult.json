{
  "$defs": {
    "BatteryTraceTimeseries": {
      "description": "Per-step battery trace timeseries (v2.2.0 SSoT).\n\nThis is the SINGLE SOURCE OF TRUTH for battery state and power flows\nat each timestep during dispatch simulation.\n\nReturned only when include_battery_trace=true to avoid payload bloat.\n\nUsed for:\n- Debugging: verify SOC evolution and charge/discharge decisions\n- Transparency: user can see exact power flows at each timestep\n- Validation: SOC bounds and power limits invariants\n- Visualization: chart SOC and power over time",
      "properties": {
        "battery_energy_kwh": {
          "description": "Battery energy capacity [kWh] for SOC bounds validation",
          "title": "Battery Energy Kwh",
          "type": "number"
        },
        "battery_power_kw": {
          "description": "Battery power capacity [kW] for power limits validation",
          "title": "Battery Power Kw",
          "type": "number"
        },
        "charge_from_grid_kw": {
          "description": "Charge from grid at each timestep [kW]. All values >= 0. Only with allow_grid_charging. Length = steps.",
          "items": {
            "type": "number"
          },
          "title": "Charge From Grid Kw",
          "type": "array"
        },
        "charge_from_pv_kw": {
          "description": "Charge from PV surplus at each timestep [kW]. All values >= 0. Length = steps.",
          "items": {
            "type": "number"
          },
          "title": "Charge From Pv Kw",
          "type": "array"
        },
        "charge_kw": {
          "description": "Battery charge power at each timestep [kW]. All values >= 0. Length = steps.",
          "items": {
            "type": "number"
          },
          "title": "Charge Kw",
          "type": "array"
        },
        "discharge_kw": {
          "description": "Battery discharge power at each timestep [kW]. All values >= 0. Length = steps.",
          "items": {
            "type": "number"
          },
          "title": "Discharge Kw",
          "type": "array"
        },
        "discharge_to_grid_kw": {
          "description": "Discharge to grid (export) at each timestep [kW]. All values >= 0. Length = steps.",
          "items": {
            "type": "number"
          },
          "title": "Discharge To Grid Kw",
          "type": "array"
        },
        "discharge_to_load_kw": {
          "description": "Discharge to load at each timestep [kW]. All values >= 0. Length = steps.",
          "items": {
            "type": "number"
          },
          "title": "Discharge To Load Kw",
          "type": "array"
        },
        "soc_kwh": {
          "description": "Battery SOC at end of each timestep [kWh]. Length = steps.",
          "items": {
            "type": "number"
          },
          "title": "Soc Kwh",
          "type": "array"
        },
        "step_minutes": {
          "description": "Time resolution in minutes (15 or 60)",
          "maximum": 60,
          "minimum": 15,
          "title": "Step Minutes",
          "type": "integer"
        },
        "steps": {
          "description": "Number of timesteps",
          "minimum": 1,
          "title": "Steps",
          "type": "integer"
        }
      },
      "required": [
        "soc_kwh",
        "charge_kw",
        "discharge_kw",
        "charge_from_pv_kw",
        "discharge_to_load_kw",
        "steps",
        "step_minutes",
        "battery_energy_kwh",
        "battery_power_kw"
      ],
      "title": "BatteryTraceTimeseries",
      "type": "object"
    },
    "ConstraintSummary": {
      "description": "Summary of grid constraint impacts (v0.7.0).\n\nTracks how often and how much constraints were hit during dispatch.",
      "properties": {
        "export_cap_curtailed_kwh": {
          "default": 0.0,
          "description": "Total energy curtailed due to export cap [kWh]",
          "title": "Export Cap Curtailed Kwh",
          "type": "number"
        },
        "export_cap_hit_steps": {
          "default": 0,
          "description": "Number of timesteps where export was capped by max_export_kw",
          "title": "Export Cap Hit Steps",
          "type": "integer"
        },
        "import_cap_hit_steps": {
          "default": 0,
          "description": "Number of timesteps where import was capped by max_import_kw",
          "title": "Import Cap Hit Steps",
          "type": "integer"
        },
        "unserved_load_kwh": {
          "default": 0.0,
          "description": "Total energy unserved due to import cap [kWh]",
          "title": "Unserved Load Kwh",
          "type": "number"
        }
      },
      "title": "ConstraintSummary",
      "type": "object"
    },
    "DebugEvents": {
      "description": "Debug events summary (v1.8.0).\n\nAggregates key debugging information from constraint_summary and energy_flows\ninto a single, easy-to-read block for debugging and repro analysis.",
      "properties": {
        "export_limited_mwh": {
          "default": 0.0,
          "description": "Total export energy limited [MWh]",
          "title": "Export Limited Mwh",
          "type": "number"
        },
        "export_limited_steps": {
          "default": 0,
          "description": "Steps where export was limited by max_export_kw",
          "title": "Export Limited Steps",
          "type": "integer"
        },
        "import_limited_mwh": {
          "default": 0.0,
          "description": "Total import energy limited (unserved load) [MWh]",
          "title": "Import Limited Mwh",
          "type": "number"
        },
        "import_limited_steps": {
          "default": 0,
          "description": "Steps where import was limited by max_import_kw",
          "title": "Import Limited Steps",
          "type": "integer"
        },
        "pv_curtail_mwh": {
          "default": 0.0,
          "description": "Total PV energy curtailed [MWh]",
          "title": "Pv Curtail Mwh",
          "type": "number"
        },
        "pv_curtail_steps": {
          "default": 0,
          "description": "Steps where PV was curtailed",
          "title": "Pv Curtail Steps",
          "type": "integer"
        },
        "steps": {
          "default": 0,
          "description": "Total number of timesteps in simulation",
          "title": "Steps",
          "type": "integer"
        },
        "unserved_load_kwh": {
          "default": 0.0,
          "description": "Total unserved load [kWh]",
          "title": "Unserved Load Kwh",
          "type": "number"
        },
        "unserved_load_steps": {
          "default": 0,
          "description": "Steps with unserved load",
          "title": "Unserved Load Steps",
          "type": "integer"
        }
      },
      "title": "DebugEvents",
      "type": "object"
    },
    "DegradationMetrics": {
      "description": "Degradation and cycling metrics",
      "properties": {
        "arb_charge_from_grid_kwh": {
          "default": 0.0,
          "description": "Energy charged from grid for arbitrage [kWh]",
          "title": "Arb Charge From Grid Kwh",
          "type": "number"
        },
        "arb_cycles_count": {
          "default": 0,
          "description": "Number of arbitrage charge/discharge cycles",
          "title": "Arb Cycles Count",
          "type": "integer"
        },
        "arb_discharge_kwh": {
          "default": 0.0,
          "description": "Energy discharged for arbitrage [kWh]",
          "title": "Arb Discharge Kwh",
          "type": "number"
        },
        "avg_daily_efc": {
          "default": 0.0,
          "description": "Average EFC per day",
          "title": "Avg Daily Efc",
          "type": "number"
        },
        "avg_daily_throughput_mwh": {
          "default": 0.0,
          "description": "Average throughput per day [MWh]",
          "title": "Avg Daily Throughput Mwh",
          "type": "number"
        },
        "budget_status": {
          "$ref": "#/$defs/DegradationStatus",
          "default": "ok"
        },
        "budget_utilization_pct": {
          "default": 0.0,
          "description": "Budget utilization [%]",
          "title": "Budget Utilization Pct",
          "type": "number"
        },
        "budget_warnings": {
          "items": {
            "type": "string"
          },
          "title": "Budget Warnings",
          "type": "array"
        },
        "charge_from_grid_kwh": {
          "default": 0.0,
          "description": "Energy charged from grid [kWh]",
          "title": "Charge From Grid Kwh",
          "type": "number"
        },
        "charge_from_pv_kwh": {
          "default": 0.0,
          "description": "Energy charged from PV surplus [kWh]",
          "title": "Charge From Pv Kwh",
          "type": "number"
        },
        "charge_pv_pct": {
          "default": 0.0,
          "description": "Percentage of charge from PV [%]",
          "title": "Charge Pv Pct",
          "type": "number"
        },
        "days_exceeding_cycle_limit": {
          "default": 0,
          "description": "Days where daily cycle limit was exceeded",
          "title": "Days Exceeding Cycle Limit",
          "type": "integer"
        },
        "days_exceeding_throughput_limit": {
          "default": 0,
          "description": "Days where daily throughput limit was exceeded",
          "title": "Days Exceeding Throughput Limit",
          "type": "integer"
        },
        "efc_arb": {
          "default": 0.0,
          "description": "EFC for arbitrage",
          "title": "Efc Arb",
          "type": "number"
        },
        "efc_peak": {
          "default": 0.0,
          "description": "EFC for peak shaving",
          "title": "Efc Peak",
          "type": "number"
        },
        "efc_pv": {
          "default": 0.0,
          "description": "EFC for PV shifting",
          "title": "Efc Pv",
          "type": "number"
        },
        "efc_total": {
          "default": 0.0,
          "description": "Total equivalent full cycles",
          "title": "Efc Total",
          "type": "number"
        },
        "max_daily_efc": {
          "default": 0.0,
          "description": "Max EFC in any single day",
          "title": "Max Daily Efc",
          "type": "number"
        },
        "max_daily_throughput_mwh": {
          "default": 0.0,
          "description": "Max throughput in any single day [MWh]",
          "title": "Max Daily Throughput Mwh",
          "type": "number"
        },
        "n_days": {
          "default": 0,
          "description": "Number of days in analysis period",
          "title": "N Days",
          "type": "integer"
        },
        "peak_events_count": {
          "default": 0,
          "description": "Number of hours with peak shaving discharge",
          "title": "Peak Events Count",
          "type": "integer"
        },
        "peak_events_energy_kwh": {
          "default": 0.0,
          "description": "Total energy discharged for peak shaving [kWh]",
          "title": "Peak Events Energy Kwh",
          "type": "number"
        },
        "peak_max_discharge_kw": {
          "default": 0.0,
          "description": "Maximum discharge power for peak shaving [kW]",
          "title": "Peak Max Discharge Kw",
          "type": "number"
        },
        "throughput_arb_mwh": {
          "default": 0.0,
          "description": "Throughput for arbitrage [MWh]",
          "title": "Throughput Arb Mwh",
          "type": "number"
        },
        "throughput_charge_kwh": {
          "default": 0.0,
          "description": "Total energy charged [kWh]",
          "title": "Throughput Charge Kwh",
          "type": "number"
        },
        "throughput_discharge_kwh": {
          "default": 0.0,
          "description": "Total energy discharged [kWh]",
          "title": "Throughput Discharge Kwh",
          "type": "number"
        },
        "throughput_peak_mwh": {
          "default": 0.0,
          "description": "Throughput for peak shaving [MWh]",
          "title": "Throughput Peak Mwh",
          "type": "number"
        },
        "throughput_pv_mwh": {
          "default": 0.0,
          "description": "Throughput for PV shifting [MWh]",
          "title": "Throughput Pv Mwh",
          "type": "number"
        },
        "throughput_total_mwh": {
          "default": 0.0,
          "description": "Total throughput [MWh]",
          "title": "Throughput Total Mwh",
          "type": "number"
        }
      },
      "title": "DegradationMetrics",
      "type": "object"
    },
    "DegradationStatus": {
      "description": "Degradation budget status",
      "enum": [
        "ok",
        "warning",
        "exceeded"
      ],
      "title": "DegradationStatus",
      "type": "string"
    },
    "DispatchMode": {
      "description": "BESS dispatch modes",
      "enum": [
        "pv_surplus",
        "peak_shaving",
        "stacked",
        "arbitrage",
        "load_only"
      ],
      "title": "DispatchMode",
      "type": "string"
    },
    "EconomicsBreakdown": {
      "description": "Complete economics breakdown structure (v1.5.0).\n\nContains:\n- totals_pln: Always present (aggregate values matching savings_breakdown)\n- timeseries_pln: Only when requested via include_economics_timeseries flag\n\nUsage invariants:\n- sum(timeseries_pln.energy_cost_baseline_pln) ≈ totals_pln.energy_cost_baseline_pln\n- totals_pln.energy_savings_pln ≈ savings_breakdown.energy_savings_pln",
      "properties": {
        "timeseries_pln": {
          "anyOf": [
            {
              "$ref": "#/$defs/EconomicsTimeseriesPln"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Per-timestep values in PLN (only if include_economics_timeseries=True)"
        },
        "totals_pln": {
          "$ref": "#/$defs/EconomicsTotalsPln",
          "description": "Aggregate totals in PLN (always present)"
        }
      },
      "title": "EconomicsBreakdown",
      "type": "object"
    },
    "EconomicsTimeseriesPln": {
      "description": "Per-timestep economics in PLN.\n\nOnly included when include_economics_timeseries=True.\nUseful for debugging and detailed economic analysis.\n\nInvariants:\n- sum(energy_cost_baseline_pln) = totals.energy_cost_baseline_pln\n- sum(energy_cost_project_pln) = totals.energy_cost_project_pln\n- sum(capacity_fee_pln) = totals.capacity_fee_project_pln (if applicable)",
      "properties": {
        "energy_cost_baseline_pln": {
          "description": "Per-step energy cost without battery [PLN]",
          "items": {
            "type": "number"
          },
          "title": "Energy Cost Baseline Pln",
          "type": "array"
        },
        "energy_cost_project_pln": {
          "description": "Per-step energy cost with battery [PLN]",
          "items": {
            "type": "number"
          },
          "title": "Energy Cost Project Pln",
          "type": "array"
        },
        "export_revenue_pln": {
          "description": "Per-step export revenue [PLN]",
          "items": {
            "type": "number"
          },
          "title": "Export Revenue Pln",
          "type": "array"
        }
      },
      "title": "EconomicsTimeseriesPln",
      "type": "object"
    },
    "EconomicsTotalsPln": {
      "description": "Aggregate economics totals in PLN for the analysis period.\n\nAlways present in EconomicsBreakdown (small payload).\nThese are per-period totals that sum up to the same values as savings_breakdown.",
      "properties": {
        "capacity_fee_baseline_pln": {
          "default": 0.0,
          "description": "Capacity fee without battery [PLN]",
          "title": "Capacity Fee Baseline Pln",
          "type": "number"
        },
        "capacity_fee_project_pln": {
          "default": 0.0,
          "description": "Capacity fee with battery [PLN]",
          "title": "Capacity Fee Project Pln",
          "type": "number"
        },
        "capacity_fee_savings_pln": {
          "default": 0.0,
          "description": "Capacity fee savings = baseline - project [PLN]",
          "title": "Capacity Fee Savings Pln",
          "type": "number"
        },
        "degradation_cost_pln": {
          "default": 0.0,
          "description": "Battery degradation cost [PLN]",
          "title": "Degradation Cost Pln",
          "type": "number"
        },
        "demand_charge_baseline_pln": {
          "default": 0.0,
          "description": "Demand charge without battery [PLN]",
          "title": "Demand Charge Baseline Pln",
          "type": "number"
        },
        "demand_charge_project_pln": {
          "default": 0.0,
          "description": "Demand charge with battery [PLN]",
          "title": "Demand Charge Project Pln",
          "type": "number"
        },
        "demand_charge_savings_pln": {
          "default": 0.0,
          "description": "Demand charge savings = baseline - project [PLN]",
          "title": "Demand Charge Savings Pln",
          "type": "number"
        },
        "energy_cost_baseline_pln": {
          "default": 0.0,
          "description": "Total energy cost without battery [PLN]",
          "title": "Energy Cost Baseline Pln",
          "type": "number"
        },
        "energy_cost_project_pln": {
          "default": 0.0,
          "description": "Total energy cost with battery [PLN]",
          "title": "Energy Cost Project Pln",
          "type": "number"
        },
        "energy_savings_pln": {
          "default": 0.0,
          "description": "Energy cost savings = baseline - project [PLN]",
          "title": "Energy Savings Pln",
          "type": "number"
        },
        "export_revenue_pln": {
          "default": 0.0,
          "description": "Revenue from grid export [PLN]",
          "title": "Export Revenue Pln",
          "type": "number"
        }
      },
      "title": "EconomicsTotalsPln",
      "type": "object"
    },
    "EnergyFlows": {
      "description": "Complete energy flows structure.\n\nContains:\n- totals_mwh: Always present (small, for UI and golden tests)\n- timeseries_kwh: Only when requested via include_energy_flows_timeseries flag\n\nUsage invariants:\n- sum(timeseries_kwh) / 1000 ≈ totals_mwh (within floating point tolerance)\n- Load balance: load_kwh[t] ≈ pv_to_load[t] + batt_to_load[t] + grid_import[t]",
      "properties": {
        "timeseries_kwh": {
          "anyOf": [
            {
              "$ref": "#/$defs/EnergyFlowsTimeseriesKwh"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Per-timestep values in kWh (only if include_energy_flows_timeseries=True)"
        },
        "totals_mwh": {
          "$ref": "#/$defs/EnergyFlowsTotalsMwh",
          "description": "Aggregate totals in MWh (always present)"
        }
      },
      "title": "EnergyFlows",
      "type": "object"
    },
    "EnergyFlowsTimeseriesKwh": {
      "description": "Per-timestep energy flows in kWh.\n\nOnly included in response when include_energy_flows_timeseries=True.\nUseful for debugging and detailed analysis.",
      "properties": {
        "batt_charge_from_grid_kwh": {
          "description": "Battery charge from grid per step [kWh]",
          "items": {
            "type": "number"
          },
          "title": "Batt Charge From Grid Kwh",
          "type": "array"
        },
        "batt_losses_kwh": {
          "description": "Battery losses per step [kWh]",
          "items": {
            "type": "number"
          },
          "title": "Batt Losses Kwh",
          "type": "array"
        },
        "batt_to_load_kwh": {
          "description": "Battery to load per step [kWh]",
          "items": {
            "type": "number"
          },
          "title": "Batt To Load Kwh",
          "type": "array"
        },
        "grid_export_kwh": {
          "description": "Grid export per step [kWh]",
          "items": {
            "type": "number"
          },
          "title": "Grid Export Kwh",
          "type": "array"
        },
        "grid_import_kwh": {
          "description": "Grid import per step [kWh]",
          "items": {
            "type": "number"
          },
          "title": "Grid Import Kwh",
          "type": "array"
        },
        "pv_curtail_kwh": {
          "description": "PV curtailed per step [kWh]",
          "items": {
            "type": "number"
          },
          "title": "Pv Curtail Kwh",
          "type": "array"
        },
        "pv_to_batt_kwh": {
          "description": "PV to battery per step [kWh]",
          "items": {
            "type": "number"
          },
          "title": "Pv To Batt Kwh",
          "type": "array"
        },
        "pv_to_load_kwh": {
          "description": "PV to load per step [kWh]",
          "items": {
            "type": "number"
          },
          "title": "Pv To Load Kwh",
          "type": "array"
        },
        "soc_kwh": {
          "description": "State of charge per step [kWh]",
          "items": {
            "type": "number"
          },
          "title": "Soc Kwh",
          "type": "array"
        }
      },
      "title": "EnergyFlowsTimeseriesKwh",
      "type": "object"
    },
    "EnergyFlowsTotalsMwh": {
      "description": "Total energy flows in MWh for the analysis period.\n\nThis is the SINGLE SOURCE OF TRUTH for energy accounting.\nAll values are in MWh and represent totals over the period.",
      "properties": {
        "batt_charge_from_grid_mwh": {
          "default": 0.0,
          "description": "Battery charge from grid [MWh]",
          "title": "Batt Charge From Grid Mwh",
          "type": "number"
        },
        "batt_losses_mwh": {
          "default": 0.0,
          "description": "Battery round-trip losses [MWh]",
          "title": "Batt Losses Mwh",
          "type": "number"
        },
        "batt_to_load_mwh": {
          "default": 0.0,
          "description": "Battery discharge to load [MWh]",
          "title": "Batt To Load Mwh",
          "type": "number"
        },
        "grid_export_mwh": {
          "default": 0.0,
          "description": "Total grid export [MWh]",
          "title": "Grid Export Mwh",
          "type": "number"
        },
        "grid_import_mwh": {
          "default": 0.0,
          "description": "Total grid import [MWh]",
          "title": "Grid Import Mwh",
          "type": "number"
        },
        "pv_curtail_mwh": {
          "default": 0.0,
          "description": "PV energy curtailed [MWh]",
          "title": "Pv Curtail Mwh",
          "type": "number"
        },
        "pv_to_batt_mwh": {
          "default": 0.0,
          "description": "PV energy charged to battery [MWh]",
          "title": "Pv To Batt Mwh",
          "type": "number"
        },
        "pv_to_load_mwh": {
          "default": 0.0,
          "description": "PV energy directly consumed by load [MWh]",
          "title": "Pv To Load Mwh",
          "type": "number"
        }
      },
      "title": "EnergyFlowsTotalsMwh",
      "type": "object"
    },
    "HourlyDispatch": {
      "description": "Hourly dispatch data (for detailed analysis)",
      "properties": {
        "charge_kw": {
          "title": "Charge Kw",
          "type": "number"
        },
        "curtailment_kw": {
          "title": "Curtailment Kw",
          "type": "number"
        },
        "direct_pv_kw": {
          "title": "Direct Pv Kw",
          "type": "number"
        },
        "discharge_arb_kw": {
          "default": 0.0,
          "title": "Discharge Arb Kw",
          "type": "number"
        },
        "discharge_kw": {
          "title": "Discharge Kw",
          "type": "number"
        },
        "discharge_peak_kw": {
          "default": 0.0,
          "title": "Discharge Peak Kw",
          "type": "number"
        },
        "discharge_pv_kw": {
          "default": 0.0,
          "title": "Discharge Pv Kw",
          "type": "number"
        },
        "grid_export_kw": {
          "title": "Grid Export Kw",
          "type": "number"
        },
        "grid_import_kw": {
          "title": "Grid Import Kw",
          "type": "number"
        },
        "load_kw": {
          "title": "Load Kw",
          "type": "number"
        },
        "pv_kw": {
          "title": "Pv Kw",
          "type": "number"
        },
        "soc_kwh": {
          "title": "Soc Kwh",
          "type": "number"
        },
        "soc_pct": {
          "title": "Soc Pct",
          "type": "number"
        },
        "timestep": {
          "title": "Timestep",
          "type": "integer"
        }
      },
      "required": [
        "timestep",
        "pv_kw",
        "load_kw",
        "direct_pv_kw",
        "charge_kw",
        "discharge_kw",
        "grid_import_kw",
        "grid_export_kw",
