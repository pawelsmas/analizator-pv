      "required": [
        "import_price_pln_mwh",
        "export_price_pln_mwh",
        "demand_charge_pln_kw_month"
      ],
      "title": "PricesSummary",
      "type": "object"
    },
    "SavingsBreakdown": {
      "description": "Detailed breakdown of annual savings by source.\n\nUsed for transparent NPV calculation and frontend display.\nSum of all components equals net_savings_pln.\n\nNOTE on terminology:\n- demand_charge_savings_pln = peak shaving (opłata za moc umowną / demand charge)\n- capacity_fee_savings_pln = opłata mocowa PL (rynek mocy) - osobny moduł\n- export_revenue_pln = revenue from grid export (sprzedaż nadwyżek do sieci)",
      "properties": {
        "arbitrage_savings_pln": {
          "default": 0.0,
          "description": "ADDITIONAL savings from ToU price spread (tou_total - flat_savings)",
          "title": "Arbitrage Savings Pln",
          "type": "number"
        },
        "baseline_export_revenue_pln": {
          "default": 0.0,
          "description": "Export revenue WITHOUT battery (PV surplus only)",
          "title": "Baseline Export Revenue Pln",
          "type": "number"
        },
        "battery_throughput_mwh": {
          "default": 0.0,
          "description": "Total battery throughput [MWh] (discharge only)",
          "title": "Battery Throughput Mwh",
          "type": "number"
        },
        "capacity_fee_savings_pln": {
          "default": 0.0,
          "description": "Savings from reduced capacity fee (opłata mocowa PL)",
          "title": "Capacity Fee Savings Pln",
          "type": "number"
        },
        "degradation_cost_pln": {
          "default": 0.0,
          "description": "Cost of battery degradation (throughput-based)",
          "title": "Degradation Cost Pln",
          "type": "number"
        },
        "demand_charge_savings_pln": {
          "default": 0.0,
          "description": "Savings from peak shaving (opłata za moc / demand charge)",
          "title": "Demand Charge Savings Pln",
          "type": "number"
        },
        "energy_savings_pln": {
          "default": 0.0,
          "description": "Savings from reduced grid import at flat price (volume × flat_rate)",
          "title": "Energy Savings Pln",
          "type": "number"
        },
        "export_revenue_pln": {
          "default": 0.0,
          "description": "[DEPRECATED] Use project_export_revenue_pln instead. This field equals project_export_revenue_pln for backward compatibility.",
          "title": "Export Revenue Pln",
          "type": "number"
        },
        "export_revenue_savings_pln": {
          "default": 0.0,
          "description": "Change in export revenue = project - baseline (typically negative)",
          "title": "Export Revenue Savings Pln",
          "type": "number"
        },
        "net_savings_pln": {
          "default": 0.0,
          "description": "Net annual savings = energy + demand + arbitrage + capacity_fee + export_delta - degradation - unserved_penalty",
          "title": "Net Savings Pln",
          "type": "number"
        },
        "project_export_revenue_pln": {
          "default": 0.0,
          "description": "Export revenue WITH battery (reduced due to self-consumption)",
          "title": "Project Export Revenue Pln",
          "type": "number"
        },
        "unserved_load_penalty_pln": {
          "default": 0.0,
          "description": "Penalty for unserved load due to import cap [PLN]",
          "title": "Unserved Load Penalty Pln",
          "type": "number"
        }
      },
      "title": "SavingsBreakdown",
      "type": "object"
    }
  },
